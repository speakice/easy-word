<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 竖向排布：拼音 → 范字 → 练写田字格 → 词组/巧记/场景 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部：拼音居中（喇叭在范字右侧，见下面的范字区） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textPinyin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/gray"
                android:textSize="34sp"
                android:text="jiā" />
        </FrameLayout>

        <!-- 范字区：范字与描红覆盖层同一区域，左右居中 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5">

            <TextView
                android:id="@+id/textWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:text="家"
                android:translationY="12dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="72sp"
                app:autoSizeMaxTextSize="220sp"
                app:autoSizeStepGranularity="2sp" />

            <com.easyword.learn.view.StrokeAnimationView
                android:id="@+id/strokeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationY="12dp" />

            <!-- 范字的喇叭：放在范字右侧、垂直居中；写在描红层后面才能点在它上面 -->
            <Button
                android:id="@+id/btnPlayWord"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_semi_black"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/btn_speak"
                android:textColor="@color/yellow"
                android:textSize="15sp"
                android:translationY="12dp" />
        </FrameLayout>

        <!-- 知识面板：词组 → 场景（同字号）→ 巧记（小一号、灰色，弱化）；放在写字区上方 -->
        <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlayWords"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_semi_black"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/btn_speak"
                    android:textColor="@color/yellow"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textWords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#F2F2F2"
                    android:textSize="20sp"
                    android:text="家庭 · 家人 · 回家" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlayUsage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_semi_black"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/btn_speak"
                    android:textColor="@color/yellow"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textUsage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#F2F2F2"
                    android:textSize="20sp"
                    android:text="家人的爱，家家都有。" />
            </LinearLayout>

            <!-- 巧记排最后：字号小一点、颜色淡一点，明确它是补充信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlayRhyme"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_semi_black"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/btn_speak"
                    android:textColor="@color/yellow"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textRhyme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#9E9E9E"
                    android:textSize="15sp"
                    android:text="左右结构，左边是「女」，右边是「子」" />
            </LinearLayout>
        </LinearLayout>

        <!-- 写字区按钮：原来在田字格左右，现在统一挪到田字格上方正中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="32dp"
                android:alpha="0.7"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/save_drawing"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save_image" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:alpha="0.7"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/clear_stroke"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_broom" />
        </LinearLayout>

        <!--
          练写区：宽度撑满卡片左右，高度取和宽度一样的正方形（DrawingView 自己算）。
          高度不够时它会缩成小一点的正方形，不会把上面的范字挤掉。
        -->
        <com.easyword.learn.view.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_draw_strip" />
    </LinearLayout>

    <!-- 飘心动画 -->
    <TextView
        android:id="@+id/heartOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="❤️"
        android:textSize="140sp"
        android:visibility="gone" />
</FrameLayout>
