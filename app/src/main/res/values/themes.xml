<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EasyWord" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/yellow</item>
    </style>

    <!-- 统一的返回按钮：小胶囊 + 箭头图标 + “返回”，各个页面共用 -->
    <style name="Widget.EasyWord.BackButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_back_button</item>
        <item name="android:drawableStart">@drawable/ic_back</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:text">@string/favorite_back</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
