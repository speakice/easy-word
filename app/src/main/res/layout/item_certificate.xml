<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_certificate"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textCertTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:textColor="#FFD54F"
        android:textSize="22sp"
        android:text="小学毕业证明" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/textCertBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.7"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:text="已学完小学阶段 600 个汉字" />

    <TextView
        android:id="@+id/textCertScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#E53935"
        android:textSize="22sp"
        android:text="小升初考试 85 分 · 成绩合格" />

    <TextView
        android:id="@+id/textCertDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/gray"
        android:textSize="13sp"
        android:text="轻松识字 · 2026年9月28日" />

    <TextView
        android:id="@+id/textCertSeal"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_seal"
        android:gravity="center"
        android:rotation="-12"
        android:text="轻松识字\n· 已核发 ·"
        android:textColor="#E53935"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_semi_black"
        android:text="申请毕业"
        android:textColor="@color/yellow"
        android:textSize="19sp"
        android:visibility="gone" />
</LinearLayout>
