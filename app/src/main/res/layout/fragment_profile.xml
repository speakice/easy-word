<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部：头像 + 学习进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <TextView
                    android:id="@+id/textAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_gold"
                    android:gravity="center"
                    android:text="字"
                    android:textColor="@color/black"
                    android:textSize="32sp" />

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/settings_avatar"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textNickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="我的学习"
                    android:textColor="@color/white"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/textStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/yellow"
                    android:textSize="15sp"
                    android:text="识字 0 · 已学 0 · 未识 0" />

                <ProgressBar
                    android:id="@+id/progressLearn"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    android:max="950"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_learn" />

                <TextView
                    android:id="@+id/textTotalProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/gray"
                    android:textSize="13sp"
                    android:text="950 字学习进度：0%" />
            </LinearLayout>

            <!-- 设置：放在个人信息右上角 -->
            <TextView
                android:id="@+id/btnSettingsHeader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/settings_entry"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 学习热力图：整年铺满一行，不滚动、不带外框 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="学习热力图（绿色越深，那天学得越久）"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <!-- 时间切换：2026年上 / 2026年下 …（只有一个半年时不显示） -->
        <HorizontalScrollView
            android:id="@+id/periodScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/periodBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </HorizontalScrollView>

        <com.easyword.learn.ui.HeatmapView
            android:id="@+id/heatmap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="6dp"
            android:text="我的"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowBoxMine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            android:text="字表"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowBoxLists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            android:text="@string/extend_group"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowBoxExtend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="#808080"
            android:textSize="12sp"
            android:text="组词 / 记字 / 例句来自 CC-CEDICT、Tatoeba、makemeahanzi 等开放数据" />
    </LinearLayout>
</ScrollView>
